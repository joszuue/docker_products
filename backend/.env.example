# ==============================================================================
# Configuración del Backend Laravel (Entorno de Producción / Docker)
# ==============================================================================

APP_NAME="Gestor de Productos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Configuración de Base de Datos MySQL (Interna en red Docker)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=productos_db
DB_USERNAME=productos_user
DB_PASSWORD=secret_db_password

# Control de ejecución de migraciones en arranque
AUTO_MIGRATE=true

# Almacenamiento y sesiones
FILESYSTEM_DISK=public
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
