# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO DE CONTENEDORES (DOCKER COMPOSE)
# Copia este archivo como .env antes de ejecutar docker compose:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Configuración del Backend (Laravel)
# ------------------------------------------------------------------------------
APP_NAME="Gestor de Productos"
APP_ENV=production
# Genera tu APP_KEY una única vez con: docker compose run --rm backend php artisan key:generate --show
# o localmente con: php artisan key:generate --show
APP_KEY=base64:EXAMPLE_APP_KEY_REPLACE_WITH_REAL_GENERATED_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Control de migraciones automáticas al iniciar el contenedor (true / false)
AUTO_MIGRATE=true

# ------------------------------------------------------------------------------
# Configuración de Base de Datos MySQL
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=secret_root_password
DB_DATABASE=productos_db
DB_USERNAME=productos_user
DB_PASSWORD=secret_user_password

# ------------------------------------------------------------------------------
# Configuración del Frontend (Next.js)
# ------------------------------------------------------------------------------
# Variables públicas embebidas durante la construcción y ejecución
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_STORAGE_URL=http://localhost:8000/storage
