# Archivos de entorno y secretos
.env
.env.backup
.env.production
.env.local
.env.*.local
*.pem
*.key

# Dependencias de Node.js y Laravel
node_modules/
vendor/

# Archivos de compilación de Next.js
.next/
out/
build/
dist/

# Logs y temporales
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Almacenamiento local de Laravel y cachés
backend/storage/*.key
backend/storage/app/public/products/*
!backend/storage/app/public/.gitignore
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore
backend/database/*.sqlite
backend/database/*.sqlite-journal

# Tests y cobertura
.phpunit.result.cache
coverage/

# IDEs y sistemas operativos
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

